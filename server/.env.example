# Copy file này thành .env trên server
# cp .env.example .env
# Sau đó điền giá trị thực vào

NODE_ENV=production
PORT=3001

# JWT – PHẢI đổi, sinh ngẫu nhiên: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_STRONG_SECRET_64_CHARS

# Google Drive Backup (tùy chọn)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=

# Zalo OA (tùy chọn)
ZALO_APP_ID=
ZALO_APP_SECRET=
ZALO_OA_TOKEN=
ZALO_OA_REFRESH_TOKEN=
